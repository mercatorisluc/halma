#!/bin/sh
# Runs before every commit. Enable once per clone with:
#
#     git config core.hooksPath .githooks
#
# Checks the four things that must stay green. Type checking is the reason this
# hook exists: ruff does not look at types, so a warning like assigning an
# int|str into a list[str] passes lint and only shows up in the editor.
#
# To commit anyway (a work in progress, say): git commit --no-verify

set -e

if [ -x .venv/bin/python3 ]; then
    PY=.venv/bin/python3
else
    PY=python3
fi

echo "pre-commit: format"
$PY -m ruff format --check .

echo "pre-commit: lint"
$PY -m ruff check .

echo "pre-commit: types"
$PY -m basedpyright .

echo "pre-commit: tests"
$PY -m pytest -q

echo "pre-commit: all green"
