# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Virtual environments
.venv/
venv/
env/.venv/

# Trained agents. Binary, regenerable with scripts/train.py, and they would
# bloat the history -- the numbers that matter live in commit messages. The
# ** matters: train.py resolves --name against models/, so passing
# "models/foo" writes models/models/foo.zip, which a single-level pattern
# would leave showing up as untracked.
models/**/*.zip

# Run logs. A training round or a sweep is normally started detached with its
# output redirected here, so these accumulate; what they said belongs in
# ARCHITECTURE.md, not in the history.
*.log

# OS
.DS_Store

# Editor
.vscode/
.idea/

# Claude Code local settings
.claude/settings.local.json
